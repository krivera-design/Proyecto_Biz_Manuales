# Copia este archivo como .env y pega tu clave.
# El .env no se sube a ningún sitio: es solo para tu máquina.
#
# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: fijar el modelo. Si se deja vacío, el servidor elige el primer
# modelo flash disponible en tu cuenta.
# GEMINI_MODEL=gemini-2.5-flash
